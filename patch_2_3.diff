+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import datetime
+from typing import Any, Dict, List, Optional, Sequence, Tuple
+
+from dto.robo_leg_dto import FonteType, RoboLegDTO
+from infra.sqlite_conn import sqlite_conn
+from utils.leg_normalizers import (
+    normalize_call_put,
+    normalize_cv,
+    parse_timestamp,
+    parse_vencimento,
+)
+
+
+@dataclass(frozen=True)
+class RoboLegsRepoConfig:
+    app_db_path: str = "./dados/app.db"
+
+
+class RoboLegsRepository:
+    """
+    Leitura canônica por (aba, timestamp) com regra:
+      manual_analise_robo_legs > rtd_analise_robo_legs
+    """
+
+    def __init__(self, config: Optional[RoboLegsRepoConfig] = None):
+        self.config = config or RoboLegsRepoConfig()
+
+    # ----------------- API pública ----------------- #
+    def get_legs(self, aba: str, timestamp: Any) -> List[RoboLegDTO]:
+        """
+        Retorna legs para uma aba e um timestamp exatos.
+        - Primeiro tenta MANUAL
+        - Se vazio, tenta RTD
+        """
+        ts = parse_timestamp(timestamp)
+
+        manual = self._query_legs(
+            table="manual_analise_robo_legs",
+            aba=aba,
+            ts=ts,
+            fonte=FonteType.MANUAL,
+        )
+        if manual:
+            return manual
+
+        rtd = self._query_legs(
+            table="rtd_analise_robo_legs",
+            aba=aba,
+            ts=ts,
+            fonte=FonteType.RTD,
+        )
+        return rtd
+
+    def has_manual(self, aba: str, timestamp: Any) -> bool:
+        ts = parse_timestamp(timestamp)
+        with sqlite_conn(self.config.app_db_path) as conn:
+            cur = conn.execute(
+                "SELECT 1 FROM manual_analise_robo_legs WHERE aba = ? AND timestamp = ? LIMIT 1",
+                (aba, self._to_db_timestamp(ts)),
+            )
+            return cur.fetchone() is not None
+
+    def list_timestamps(self, aba: str, prefer: str = "manual_then_rtd") -> List[str]:
+        """
+        Lista timestamps disponíveis para a aba.
+        prefer:
+          - "manual_then_rtd": retorna manual se existir, senão rtd
+          - "all": união (manual ∪ rtd) ordenado
+        """
+        prefer = (prefer or "").strip().lower()
+        with sqlite_conn(self.config.app_db_path) as conn:
+            if prefer == "all":
+                rows = conn.execute(
+                    """
+                    SELECT timestamp FROM manual_analise_robo_legs WHERE aba = ?
+                    UNION
+                    SELECT timestamp FROM rtd_analise_robo_legs WHERE aba = ?
+                    ORDER BY timestamp
+                    """,
+                    (aba, aba),
+                ).fetchall()
+                return [r["timestamp"] for r in rows]
+
+            # manual_then_rtd
+            rows_m = conn.execute(
+                "SELECT DISTINCT timestamp FROM manual_analise_robo_legs WHERE aba = ? ORDER BY timestamp",
+                (aba,),
+            ).fetchall()
+            if rows_m:
+                return [r["timestamp"] for r in rows_m]
+
+            rows_r = conn.execute(
+                "SELECT DISTINCT timestamp FROM rtd_analise_robo_legs WHERE aba = ? ORDER BY timestamp",
+                (aba,),
+            ).fetchall()
+            return [r["timestamp"] for r in rows_r]
+
+    # ----------------- Internos ----------------- #
+    def _query_legs(self, table: str, aba: str, ts: datetime, fonte: FonteType) -> List[RoboLegDTO]:
+        with sqlite_conn(self.config.app_db_path) as conn:
+            rows = conn.execute(
+                f"SELECT * FROM {table} WHERE aba = ? AND timestamp = ?",
+                (aba, self._to_db_timestamp(ts)),
+            ).fetchall()
+
+        out: List[RoboLegDTO] = []
+        for r in rows:
+            data = dict(r)
+            out.append(self._row_to_dto(data, fonte=fonte))
+        return out
+
+    def _row_to_dto(self, row: Dict[str, Any], fonte: FonteType) -> RoboLegDTO:
+        """
+        Mapeia colunas comuns -> DTO.
+        Observação: como os schemas podem variar, este mapeamento
+        suporta aliases frequentes.
+        """
+        # Aliases tolerados (ajuste se seus nomes forem diferentes)
+        def pick(*keys: str, default=None):
+            for k in keys:
+                if k in row and row[k] is not None:
+                    return row[k]
+            return default
+
+        aba = pick("aba")
+        timestamp = pick("timestamp")
+        cv = pick("cv", "lado", "c_v")
+        call_put = pick("call_put", "cp", "tipo", "callput")
+        strike = pick("strike", "k", "preco_exercicio")
+        quant = pick("quant", "qty", "qtd", "quantidade")
+        ativo = pick("ativo", "ticker", "cod_ativo")
+        venc = pick("vencimento", "vcto", "expiry", "expiracao")
+        preco = pick("preco", "price", "premium")
+        leg_id = pick("id", "leg_id")
+        created_at = pick("created_at", "created", "dt_created")
+        updated_at = pick("updated_at", "updated", "dt_updated")
+
+        dto = RoboLegDTO(
+            aba=str(aba).strip(),
+            timestamp=parse_timestamp(timestamp),
+            cv=normalize_cv(cv),
+            call_put=normalize_call_put(call_put),
+            strike=float(strike) if strike is not None else 0.0,
+            quant=int(quant) if quant is not None else 0,
+            ativo=str(ativo).strip().upper(),
+            vencimento=parse_vencimento(venc),
+            fonte=fonte,
+            id=int(leg_id) if leg_id is not None else None,
+            preco=float(preco) if preco is not None else None,
+            created_at=parse_timestamp(created_at) if created_at is not None else None,
+            updated_at=parse_timestamp(updated_at) if updated_at is not None else None,
+        )
+        return dto
+
+    @staticmethod
+    def _to_db_timestamp(ts: datetime) -> str:
+        """
+        Converte datetime para string compatível com igualdade no SQLite.
+        IMPORTANTe: isso pressupõe que sua coluna `timestamp` é armazenada como TEXT
+        em formato ISO-like consistente. Se seu banco armazena de outro jeito,
+        ajuste aqui para bater 100%.
+        """
+        # Mantém offset se existir
+        if ts.tzinfo is not None:
+            return ts.isoformat(timespec="seconds")
+        return ts.replace(microsecond=0).isoformat(sep=" ")
