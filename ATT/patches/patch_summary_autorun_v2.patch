@@ -1,3 +1,42 @@
+import os
+import sys
+import subprocess
+
+def _run_build_summaries(repo_root: str):
+    """
+    Executa scripts/build_payoff_summaries.py após gerar points/decisions,
+    garantindo que payoff_curve_summary fique consistente.
+    """
+    env = os.environ.copy()
+    # adiciona repo root ao PYTHONPATH para resolver "domain"
+    env["PYTHONPATH"] = repo_root + os.pathsep + env.get("PYTHONPATH", "")
+    script_path = os.path.join(repo_root, "scripts", "build_payoff_summaries.py")
+    cmd = [sys.executable, script_path]
+    print(f"[PIPELINE] Gerando payoff_curve_summary: {' '.join(cmd)}")
+    r = subprocess.run(cmd, env=env)
+    if r.returncode != 0:
+        raise SystemExit(r.returncode)
+
@@ -999,6 +1038,18 @@ def main():
     # ... pipeline existente processa abas e grava payoff_curve_points e structure_decisions ...
 
+    # Ao final, gera/atualiza summaries
+    try:
+        repo_root = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
+        _run_build_summaries(repo_root)
+    except Exception as e:
+        print(f"[PIPELINE][WARN] Falha ao gerar summaries automaticamente: {e}")
+        # Não mata o pipeline por default; ajuste para "raise" se preferir hard-fail
+
 if __name__ == "__main__":
     main()
